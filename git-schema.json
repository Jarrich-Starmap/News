{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitHub AI 项目周榜",
  "type": "object",
  "required": [
    "title",
    "period",
    "updated",
    "projects"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "榜单标题，如「GitHub AI 项目周榜」"
    },
    "period": {
      "type": "string",
      "description": "统计周期与排序说明，如「2026.07.21 – 07.27 · 按本周新增 Star 数排序」"
    },
    "updated": {
      "type": "string",
      "description": "更新日期，格式 YYYY.MM.DD"
    },
    "projects": {
      "type": "array",
      "description": "按本周新增 Star 数降序排列的项目列表",
      "items": {
        "type": "object",
        "required": [
          "rank",
          "owner",
          "repo",
          "url",
          "description",
          "stars",
          "weekly_stars"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "description": "榜单名次"
          },
          "owner": {
            "type": "string",
            "description": "仓库所有者（用户或组织）"
          },
          "repo": {
            "type": "string",
            "description": "仓库名"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "仓库 GitHub 地址"
          },
          "description": {
            "type": "string",
            "description": "项目中文简介，突出功能亮点与本周动态"
          },
          "stars": {
            "type": "string",
            "description": "总 Star 数，缩写格式，如 75k / 6.6k"
          },
          "weekly_stars": {
            "type": "string",
            "description": "本周新增 Star 数，缩写格式，如 13k / 983"
          }
        }
      }
    }
  }
}